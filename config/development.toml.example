# 本地开发环境模板：复制为 config/local.toml（已被 .gitignore 忽略）后按需修改，
# 默认加载 config/default.toml 后会自动叠加 config/local.toml。
# 或使用 BBBCM_CONFIG=config/development.toml.example 选择基础文件。
# Secret 只经 BBBCM_DATABASE_POSTGRES_URL / BBBCM_REDIS_URL 注入。

[server]
environment = "development"
bind = "127.0.0.1:8081"

[database]
backend = "sqlite"
schema_prefix = "bcm_"
sqlite_path = "data/bbbcm-dev.db"
max_connections = 1

[features]
redis = false

[worker]
embedded = true
