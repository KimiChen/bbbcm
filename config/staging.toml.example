# staging 脱敏模板。BBBCM_CONFIG=config/staging.toml.example。
# 必须覆盖 BBBCM_SERVER_BIND 与 BBBCM_DATABASE_MAX_CONNECTIONS 后才可启动。
# 空监听地址和零连接数是未配置哨兵，不是可运行默认规格。
# BBBCM_DATABASE_POSTGRES_URL / BBBCM_REDIS_URL 仅经环境或部署注入，不入 TOML。
# 使用隔离的数据和缓存实例；provider 保持未配置关闭。

[server]
environment = "staging"
bind = ""

[database]
backend = "postgres"
schema_prefix = "bcm_"
max_connections = 0

[features]
redis = true

[worker]
embedded = false

# DEC-011 未选定真实供应商；本地测试实现只能在 development/test 装配。
[adapters]
mode = "disabled"
# local_root 仅在本机覆盖文件中填写，且必须处于不被静态服务暴露的私有目录。

# 生产告警阈值未批准，不提供猜测默认值。率阈值须同时显式提供 min_samples。
[mail_alerts]
