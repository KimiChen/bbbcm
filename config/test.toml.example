# 测试环境模板：集成测试使用隔离的合成数据。
# 以 BBBCM_CONFIG=config/test.toml.example ./bbbcm-web 启动。
# 自动叠加当前工作目录的 config/local.toml；自动化测试请使用隔离工作目录。

[server]
environment = "test"
bind = "127.0.0.1:18080"

[database]
backend = "sqlite"
schema_prefix = "bcm_"
sqlite_path = "data/bbbcm-test.db"
max_connections = 1

[features]
redis = false

[worker]
embedded = true

# DEC-011 未选定真实供应商；本地测试实现只能在 development/test 装配。
[adapters]
mode = "disabled"
# local_root 仅在本机覆盖文件中填写，且必须处于不被静态服务暴露的私有目录。

# 生产告警阈值未批准，不提供猜测默认值。率阈值须同时显式提供 min_samples。
[mail_alerts]
