# 测试环境模板：集成测试使用隔离的合成数据。
# 以 BBBCM_CONFIG=config/test.toml.example ./bbbcm-web 启动。
# 自动叠加当前工作目录的 config/local.toml；自动化测试请使用隔离工作目录。

[server]
environment = "test"
bind = "127.0.0.1:18080"

[database]
backend = "sqlite"
schema_prefix = "bcm_"
sqlite_path = "data/bbbcm-test.db"
max_connections = 1

[features]
redis = false

[worker]
embedded = true

# DEC-011 未选定真实供应商；本地测试实现只能在 development/test 装配。
[adapters]
mode = "disabled"
# local_root 仅在本机覆盖文件中填写，且必须处于不被静态服务暴露的私有目录。

# 生产告警阈值未批准，不提供猜测默认值。率阈值须同时显式提供 min_samples。
[mail_alerts]

# DEC-051：普通身份默认规则已冻结，业务Flag仍默认关闭。
[identity]
password_minimum = 8
# 可选离线语料必须同时给出 password_corpus_path / password_corpus_sha256。
# 本机邮件装配在忽略的 config/local.toml 中设置 active_token_version、
# mail_from（example.invalid）及 mail_base_url（回环HTTP origin）。
# 密钥只经 BBBCM_IDENTITY_TOKEN_KEYS / BBBCM_IDENTITY_RISK_KEY 注入，禁止写入TOML。
# 操作、版本保留与恢复见 docs/development/identity.md。
