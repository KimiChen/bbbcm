# production 脱敏模板。BBBCM_CONFIG=config/production.toml.example。
# 真实部署值由 Git 忽略的 config/local.toml 或普通环境变量覆盖。
# bind=""、max_connections=0 是故意不可启动的哨兵，不代表获批端口或容量。
# 必须补 BBBCM_SERVER_BIND、BBBCM_DATABASE_MAX_CONNECTIONS；容量按 DEC-004-B 批准值。
# Secret 仅通过 BBBCM_DATABASE_POSTGRES_URL 与 BBBCM_REDIS_URL 注入，禁止写入任何 TOML。
# SMTP/S3/OAuth/Cap.js 等 provider 尚未批准/实现，保持关闭，不填写虚构值。

[server]
environment = "production"
bind = ""

[database]
backend = "postgres"
schema_prefix = "bcm_"
max_connections = 0

[features]
redis = true

[worker]
embedded = false
